{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalMap",
  "version": "0.2.0",
  "identifier": "com.localmap.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalMap",
        "width": 960,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "url": "http://127.0.0.1:20190/"
